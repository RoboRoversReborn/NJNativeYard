# Environment variable names only. Supply values in your deployment secret store.
# QA access is disabled unless both local-only flags are explicitly enabled.
GEMINI_API_KEY=
GEMINI_MODEL=
GEMINI_FALLBACK_MODEL=
PLANTNET_API_KEY=
PLANTNET_PROJECT=
NEXT_PUBLIC_SUPABASE_URL=
NEXT_PUBLIC_SUPABASE_ANON_KEY=
ENABLE_PUBLIC_EMAIL_AUTH=
EMAIL_DELIVERY_MODE=
NATIVEYARD_RUNTIME=
NATIVEYARD_QA_AUTH=

# Server-only shared botanical cache credential (never NEXT_PUBLIC).
SUPABASE_SERVICE_ROLE_KEY=
# Optional administrative setup / management fallback. Omit from ordinary clients.
SUPABASE_ACCESS_TOKEN=
