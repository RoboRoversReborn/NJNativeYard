rules_version = '2';
service cloud.firestore {
  match /databases/{database}/documents {
    function isAuthenticated() {
      return request.auth != null;
    }
    function isOwner(userId) {
      return isAuthenticated() && request.auth.uid == userId;
    }
    function isAdmin() {
      return isAuthenticated() && (
        request.auth.token.role == 'admin' ||
        request.auth.token.admin == true ||
        request.auth.token.email == "niravgadhia@gmail.com" ||
        (exists(/databases/$(database)/documents/curators/$(request.auth.uid)) &&
         get(/databases/$(database)/documents/curators/$(request.auth.uid)).data.role == 'admin') ||
        (exists(/databases/$(database)/documents/curators/$(request.auth.token.email)) &&
         get(/databases/$(database)/documents/curators/$(request.auth.token.email)).data.role == 'admin')
      );
    }
    function isCurator() {
      return isAdmin() || (isAuthenticated() && (
        request.auth.token.role == 'curator' ||
        request.auth.token.curator == true ||
        exists(/databases/$(database)/documents/curators/$(request.auth.uid)) ||
        exists(/databases/$(database)/documents/curators/$(request.auth.token.email))
      ));
    }

    match /properties/{propId} {
      allow read, delete: if isOwner(resource.data.userId);
      allow create: if isOwner(request.resource.data.userId);
      allow update: if isOwner(resource.data.userId) && request.resource.data.userId == resource.data.userId;
    }

    match /yard_areas/{areaId} {
      allow read, delete: if isOwner(resource.data.userId);
      allow create: if isOwner(request.resource.data.userId);
      allow update: if isOwner(resource.data.userId);
    }

    match /ny_surveys/{surveyId} {
      allow read, delete: if isOwner(resource.data.userId);
      allow create: if isOwner(request.resource.data.userId);
      allow update: if isOwner(resource.data.userId);
    }

    match /ny_roadmap_tasks/{taskId} {
      allow read, delete: if isOwner(resource.data.userId);
      allow create: if isOwner(request.resource.data.userId);
      allow update: if isOwner(resource.data.userId);
    }

    match /species_reference_cache/{taxaId} {
      allow read: if true;
      allow write: if false; // Only server (Firebase Admin SDK) can write
    }

    match /curated_plants/{plantId} {
      allow read: if true;
      allow create, update, delete: if isCurator();
    }

    match /curators/{userId} {
      allow read: if true;
      allow write: if isAdmin();
    }
  }
}
